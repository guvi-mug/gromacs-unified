integrator = md
dt = 0.001
nsteps = 20
nstlog = 1
nstenergy = 1
nstcalcenergy = 1
nstlist = 10
cutoff-scheme = Verlet
verlet-buffer-tolerance = 0.005
rlist = 1.0
coulombtype = Cut-off
rcoulomb = 1.0
vdwtype = Cut-off
rvdw = 1.0
pbc = xyz
tcoupl = no
pcoupl = no
constraints = none
comm-mode = Linear
nstcomm = 10
gen-vel = yes
gen-temp = 50
gen-seed = 42
